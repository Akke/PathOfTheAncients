<root>
    <styles><include src="file://{resources}/styles/custom_game/hero_selection.css" /></styles>
    <scripts><include src="file://{resources}/scripts/custom_game/hero_selection.js" /></scripts>
    <Panel class="HeroSelectionContainer">
        <Panel id="HeroSelectionRoot" hittest="true">
            <Panel id="Backdrop" hittest="false" />
            <Panel id="SelectionShell">
                <Panel id="Header">
                    <Label id="Eyebrow" text="LABYRINTH OF THE ANCIENTS" />
                    <Label id="ScreenTitle" text="Choose Your Class" />
                    <Label id="ScreenSubtitle" text="Choose a path, then select one of its three specialists." />
                </Panel>

                <Panel id="BaseStage" class="SelectionStage">
                    <Panel id="ClassCarousel">
                        <Button id="CarouselLeft" class="CarouselArrow" hittestchildren="false"><Label text="‹" /></Button>
                        <Panel id="ClassCarouselViewport">
                          <Panel id="ClassCarouselTrack">
                            <Panel id="WarriorCard" class="CardShell BaseCard">
                                <Label class="FrameDiamond Top" text="◆" hittest="false" />
                                <Panel class="CardArt">
                                    <DOTAScenePanel id="WarriorScene" class="CardScene" allowrotation="true" rotationlimits="-70 70" />
                                    <Panel class="ArtVignette" hittest="false" />
                                    <Panel class="ArtScrim" hittest="false" />
                                </Panel>
                                <Panel class="CardGlow" hittest="false" />
                                <Button id="WarriorSelect" class="CardSelectArea" hittestchildren="false">
                                    <Panel class="CardInfo">
                                        <Panel class="InfoRule" hittest="false" />
                                        <Label class="InfoDiamond" text="◆" hittest="false" />
                                        <Panel class="CardEmblem" hittest="false" />
                                        <Label class="CardTitle" text="WARRIOR" hittest="false" />
                                        <Label class="CardType" text="MARS" hittest="false" />
                                    </Panel>
                                    <Panel class="ButtonRule" hittest="false" />
                                    <Label class="LearnMoreLabel" text="Learn More" hittest="false" />
                                </Button>
                                <Label class="FrameDiamond Bottom" text="◆" hittest="false" />
                            </Panel>
                            <Panel id="RangerCard" class="CardShell BaseCard">
                                <Label class="FrameDiamond Top" text="◆" hittest="false" />
                                <Panel class="CardArt">
                                    <DOTAScenePanel id="RangerScene" class="CardScene" allowrotation="true" rotationlimits="-70 70" />
                                    <Panel class="ArtVignette" hittest="false" />
                                    <Panel class="ArtScrim" hittest="false" />
                                </Panel>
                                <Panel class="CardGlow" hittest="false" />
                                <Button id="RangerSelect" class="CardSelectArea" hittestchildren="false">
                                    <Panel class="CardInfo">
                                        <Panel class="InfoRule" hittest="false" />
                                        <Label class="InfoDiamond" text="◆" hittest="false" />
                                        <Panel class="CardEmblem" hittest="false" />
                                        <Label class="CardTitle" text="RANGER" hittest="false" />
                                        <Label class="CardType" text="HOODWINK" hittest="false" />
                                    </Panel>
                                    <Panel class="ButtonRule" hittest="false" />
                                    <Label class="LearnMoreLabel" text="Learn More" hittest="false" />
                                </Button>
                                <Label class="FrameDiamond Bottom" text="◆" hittest="false" />
                            </Panel>
                            <Panel id="MageCard" class="CardShell BaseCard">
                                <Label class="FrameDiamond Top" text="◆" hittest="false" />
                                <Panel class="CardArt">
                                    <DOTAScenePanel id="MageScene" class="CardScene" allowrotation="true" rotationlimits="-70 70" />
                                    <Panel class="ArtVignette" hittest="false" />
                                    <Panel class="ArtScrim" hittest="false" />
                                </Panel>
                                <Panel class="CardGlow" hittest="false" />
                                <Button id="MageSelect" class="CardSelectArea" hittestchildren="false">
                                    <Panel class="CardInfo">
                                        <Panel class="InfoRule" hittest="false" />
                                        <Label class="InfoDiamond" text="◆" hittest="false" />
                                        <Panel class="CardEmblem" hittest="false" />
                                        <Label class="CardTitle" text="MAGE" hittest="false" />
                                        <Label class="CardType" text="INVOKER" hittest="false" />
                                    </Panel>
                                    <Panel class="ButtonRule" hittest="false" />
                                    <Label class="LearnMoreLabel" text="Learn More" hittest="false" />
                                </Button>
                                <Label class="FrameDiamond Bottom" text="◆" hittest="false" />
                            </Panel>
                            <Panel id="MercenaryCard" class="CardShell BaseCard">
                                <Label class="FrameDiamond Top" text="◆" hittest="false" />
                                <Panel class="CardArt">
                                    <DOTAScenePanel id="MercenaryScene" class="CardScene" allowrotation="true" rotationlimits="-70 70" />
                                    <Panel class="ArtVignette" hittest="false" />
                                    <Panel class="ArtScrim" hittest="false" />
                                </Panel>
                                <Panel class="CardGlow" hittest="false" />
                                <Button id="MercenarySelect" class="CardSelectArea" hittestchildren="false">
                                    <Panel class="CardInfo">
                                        <Panel class="InfoRule" hittest="false" />
                                        <Label class="InfoDiamond" text="◆" hittest="false" />
                                        <Panel class="CardEmblem" hittest="false" />
                                        <Label class="CardTitle" text="MERCENARY" hittest="false" />
                                        <Label class="CardType" text="LEGION COMMANDER" hittest="false" />
                                    </Panel>
                                    <Panel class="ButtonRule" hittest="false" />
                                    <Label class="LearnMoreLabel" text="Learn More" hittest="false" />
                                </Button>
                                <Label class="FrameDiamond Bottom" text="◆" hittest="false" />
                            </Panel>
                            <Panel id="DruidCard" class="CardShell BaseCard">
                                <Label class="FrameDiamond Top" text="◆" hittest="false" />
                                <Panel class="CardArt">
                                    <DOTAScenePanel id="DruidScene" class="CardScene" allowrotation="true" rotationlimits="-70 70" />
                                    <Panel class="ArtVignette" hittest="false" />
                                    <Panel class="ArtScrim" hittest="false" />
                                </Panel>
                                <Panel class="CardGlow" hittest="false" />
                                <Button id="DruidSelect" class="CardSelectArea" hittestchildren="false">
                                    <Panel class="CardInfo">
                                        <Panel class="InfoRule" hittest="false" />
                                        <Label class="InfoDiamond" text="◆" hittest="false" />
                                        <Panel class="CardEmblem" hittest="false" />
                                        <Label class="CardTitle" text="DRUID" hittest="false" />
                                        <Label class="CardType" text="NATURE'S PROPHET" hittest="false" />
                                    </Panel>
                                    <Panel class="ButtonRule" hittest="false" />
                                    <Label class="LearnMoreLabel" text="Learn More" hittest="false" />
                                </Button>
                                <Label class="FrameDiamond Bottom" text="◆" hittest="false" />
                            </Panel>
                            <Panel id="MartialArtistCard" class="CardShell BaseCard">
                                <Label class="FrameDiamond Top" text="◆" hittest="false" />
                                <Panel class="CardArt">
                                    <DOTAScenePanel id="MartialArtistScene" class="CardScene" allowrotation="true" rotationlimits="-70 70" />
                                    <Panel class="ArtVignette" hittest="false" />
                                    <Panel class="ArtScrim" hittest="false" />
                                </Panel>
                                <Panel class="CardGlow" hittest="false" />
                                <Button id="MartialArtistSelect" class="CardSelectArea" hittestchildren="false">
                                    <Panel class="CardInfo">
                                        <Panel class="InfoRule" hittest="false" />
                                        <Label class="InfoDiamond" text="◆" hittest="false" />
                                        <Panel class="CardEmblem" hittest="false" />
                                        <Label class="CardTitle" text="MARTIAL ARTIST" hittest="false" />
                                        <Label class="CardType" text="JUGGERNAUT" hittest="false" />
                                    </Panel>
                                    <Panel class="ButtonRule" hittest="false" />
                                    <Label class="LearnMoreLabel" text="Learn More" hittest="false" />
                                </Button>
                                <Label class="FrameDiamond Bottom" text="◆" hittest="false" />
                            </Panel>
                          </Panel>
                        </Panel>
                        <Button id="CarouselRight" class="CarouselArrow" hittestchildren="false"><Label text="›" /></Button>
                    </Panel>
                    <Panel id="CarouselFooter"><Label id="CarouselPageLabel" text="1 / 2" /><Label text="DRAG HEROES TO ROTATE • USE ARROWS TO BROWSE" /></Panel>
                </Panel>

                <Panel id="SpecialistStage" class="SelectionStage SpecialistStage HiddenStage">
                    <Panel id="SpecialistNav"><Button id="BackButton" hittestchildren="false"><Label text="‹ BACK TO CLASSES" /></Button><Label id="SpecialistHeading" text="Choose a Specialist" /></Panel>
                    <Panel id="SpecialistBody">
                        <Panel id="SpecialistCards" />
                    </Panel>
                </Panel>

                <Panel id="SelectionFooter">
                    <Panel id="SelectionSummary"><Label class="SectionLabel" text="SELECTED PATH" /><Label id="SelectedHeroName" text="Choose a class" /><Label id="SelectedRole" text="Select a class to reveal its specialists" /></Panel>
                    <Panel id="ConfirmArea"><Label id="ReadyStatus" text="Choose a class to continue" /><Button id="ConfirmButton" enabled="false" hittestchildren="false"><Label id="ConfirmLabel" text="CONFIRM SPECIALIST" /></Button></Panel>
                </Panel>
                <Panel id="PartyFooter"><Label id="PartyStatus" text="Preparing party…" /><Label text="Your specialist becomes your playable hero." /></Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
